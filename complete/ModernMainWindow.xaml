<Window x:Class="Launcher.ModernMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Mentiz Launcher - Modern Edition" Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#0a0a0f"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrowth">
    
    <Window.Resources>
        <!-- Современные тени и эффекты -->
        <DropShadowEffect x:Key="ModernShadow" Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
        <DropShadowEffect x:Key="AccentGlow" Color="#00ff88" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
        
        <!-- Градиенты -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00ff88" Offset="0"/>
            <GradientStop Color="#00cc6a" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="SecondaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7b2cbf" Offset="0"/>
            <GradientStop Color="#5a189a" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0a0a0f" Offset="0"/>
            <GradientStop Color="#12121a" Offset="0.5"/>
            <GradientStop Color="#0d1b2a" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>
    
    <Border Background="{StaticResource BackgroundGradient}" CornerRadius="0">
        <Grid>
            <!-- Декоративные элементы фона -->
            <Grid.Effect>
                <BlurEffect Radius="0"/>
            </Grid.Effect>
            
            <!-- Анимированные фоновые круги -->
            <Ellipse Width="600" Height="600" Fill="#00ff88" Opacity="0.03" 
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-200,0,0">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>
            
            <Ellipse Width="500" Height="500" Fill="#7b2cbf" Opacity="0.04" 
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-150,-150,0,0">
                <Ellipse.Effect>
                    <BlurEffect Radius="80"/>
                </Ellipse.Effect>
            </Ellipse>
            
            <Ellipse Width="400" Height="400" Fill="#00ccff" Opacity="0.03" 
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,300,200">
                <Ellipse.Effect>
                    <BlurEffect Radius="90"/>
                </Ellipse.Effect>
            </Ellipse>
            
            <!-- Основной контент -->
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Верхняя панель с заголовком и кнопками окна -->
                <Border Grid.Row="0" Background="rgba(20, 20, 30, 0.8)" 
                        BorderBrush="rgba(255, 255, 255, 0.05)" BorderThickness="0,0,0,1"
                        Padding="20,15,20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Логотип и заголовок -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="10" 
                                    Background="{StaticResource PrimaryGradient}"
                                    Margin="0,0,15,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00ff88" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <TextBlock Text="M" FontSize="24" FontWeight="Bold" 
                                           Foreground="#0a0a0f" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,0,0,2"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MENTIZ LAUNCHER" FontSize="18" FontWeight="Bold" 
                                           Foreground="#ffffff" LetterSpacing="2"/>
                                <TextBlock Text="Modern Edition" FontSize="11" 
                                           Foreground="#00ff88" FontStyle="Italic" 
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Кнопки управления окном -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="─" Width="45" Height="30" 
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#a0a0a0" FontSize="16"
                                    Cursor="Hand" Click="MinimizeClick">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="5"
                                                            Padding="10,5">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2a2a3a"/>
                                                <Setter Property="Foreground" Value="#ffffff"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <Button Content="□" Width="45" Height="30" 
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#a0a0a0" FontSize="14"
                                    Cursor="Hand" Click="MaximizeClick" Margin="5,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="5"
                                                            Padding="10,5">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2a2a3a"/>
                                                <Setter Property="Foreground" Value="#ffffff"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <Button Content="✕" Width="45" Height="30" 
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#a0a0a0" FontSize="14"
                                    Cursor="Hand" Click="CloseClick" Margin="5,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="5"
                                                            Padding="10,5">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#e81123"/>
                                                <Setter Property="Foreground" Value="#ffffff"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- WebView2 для основного контента -->
                <wv2:WebView2 Name="webView" Grid.Row="1"/>
                
                <!-- Экран загрузки -->
                <Grid Name="loadingOverlay" Grid.RowSpan="3" 
                      Background="#0a0a0f" ZIndex="100"
                      Visibility="Visible">
                    
                    <!-- Анимированный фон загрузки -->
                    <Grid.Effect>
                        <BlurEffect Radius="0"/>
                    </Grid.Effect>
                    
                    <Grid.Resources>
                        <Storyboard x:Key="LoadingAnimation" RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="loadingRing" 
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:2"/>
                            <DoubleAnimation Storyboard.TargetName="pulseCircle" 
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.3" To="0.8" Duration="0:0:1.5" 
                                             AutoReverse="True"/>
                        </Storyboard>
                    </Grid.Resources>
                    
                    <!-- Центральная композиция загрузки -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Вращающееся кольцо -->
                        <Grid Width="150" Height="150" Margin="0,0,0,40">
                            <Ellipse Width="150" Height="150" 
                                     Stroke="#1a1a2e" StrokeThickness="3"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Name="loadingRing" Width="150" Height="150" 
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00ff88" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="0.5"/>
                                        <GradientStop Color="#7b2cbf" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                                <Ellipse.StrokeThickness>
                                    <system:Double>4</system:Double>
                                </Ellipse.StrokeThickness>
                            </Ellipse>
                            
                            <!-- Пульсирующий центр -->
                            <Ellipse Name="pulseCircle" Width="80" Height="80" 
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Opacity="0.5">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#00ff88" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            
                            <!-- Логотип в центре -->
                            <Border Width="60" Height="60" CornerRadius="15" 
                                    Background="{StaticResource PrimaryGradient}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Opacity="0.9">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00ff88" BlurRadius="30" ShadowDepth="0" Opacity="0.7"/>
                                </Border.Effect>
                                <TextBlock Text="M" FontSize="36" FontWeight="Bold" 
                                           Foreground="#0a0a0f" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,0,0,3"/>
                            </Border>
                        </Grid>
                        
                        <!-- Заголовок -->
                        <TextBlock Text="MENTIZ LAUNCHER" FontSize="32" FontWeight="Bold" 
                                   Foreground="#ffffff" HorizontalAlignment="Center" 
                                   Margin="0,0,0,10" LetterSpacing="3">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00ff88" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        
                        <!-- Подзаголовок -->
                        <TextBlock Text="Modern Edition" FontSize="14" 
                                   Foreground="#00ff88" HorizontalAlignment="Center"
                                   FontStyle="Italic" Margin="0,0,0,30" LetterSpacing="1"/>
                        
                        <!-- Текст статуса -->
                        <TextBlock Name="loadingText" Text="Инициализация системы..." FontSize="16" 
                                   Foreground="#808090" HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>
                        
                        <!-- Прогресс бар -->
                        <Grid Width="400" Height="6" Margin="0,0,0,10">
                            <Rectangle Fill="#1a1a2e" RadiusX="3" RadiusY="3"/>
                            <ProgressBar Width="400" Height="6" 
                                         IsIndeterminate="True" 
                                         Margin="0,0,0,0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid>
                                                        <Border Background="#1a1a2e" CornerRadius="3"/>
                                                        <Border Name="PART_Track" CornerRadius="3"/>
                                                        <Border Name="PART_Indicator" CornerRadius="3"
                                                                Background="{StaticResource PrimaryGradient}">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#00ff88" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                                                            </Border.Effect>
                                                        </Border>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </Grid>
                        
                        <!-- Индикатор версии -->
                        <TextBlock Text="Версия 2.0.0" FontSize="12" 
                                   Foreground="#505060" HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                    
                    <!-- Декоративные линии -->
                    <Line X1="0" Y1="0" X2="0" Y2="0" Stroke="#00ff88" StrokeThickness="1" Opacity="0.1">
                        <Line.Effect>
                            <BlurEffect Radius="2"/>
                        </Line.Effect>
                    </Line>
                </Grid>
                
                <!-- Статус бар внизу -->
                <Border Grid.Row="2" Background="rgba(20, 20, 30, 0.9)" 
                        BorderBrush="rgba(255, 255, 255, 0.05)" BorderThickness="0,1,0,0"
                        Padding="20,12,20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#00ff88" Margin="0,0,10,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#00ff88" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Name="statusText" Text="Готов к работе" 
                                       Foreground="#a0a0a0" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🟢 Онлайн" Foreground="#00ff88" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
