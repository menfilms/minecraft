<Window x:Class="Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Mentiz Launcher" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#0a0a0f"
        WindowStyle="None"
        AllowsTransparency="True">
    <Grid>
        <!-- Loading Overlay -->
        <Grid Name="loadingOverlay" Background="#0a0a0f" ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="100" Height="100" CornerRadius="25" 
                        BorderBrush="#00ff88" BorderThickness="3"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#00ff88" BlurRadius="30" ShadowDepth="0"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <RotateTransform x:Name="loadingSpinner" CenterX="50" CenterY="50"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Image Source="https://api.modrinth.com/api/v1/tag/game" 
                           Stretch="Uniform" Margin="20"
                           Opacity="0.9"/>
                </Border>
                <TextBlock Text="MENTIZ LAUNCHER" FontSize="32" FontWeight="Bold" 
                           Foreground="#ffffff" HorizontalAlignment="Center" 
                           Margin="0,40,0,15"
                           LetterSpacing="5"/>
                <TextBlock Name="loadingText" Text="Инициализация..." FontSize="18" 
                           Foreground="#71717a" HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>
                <ProgressBar Width="350" Height="8" Margin="0,0,0,0" 
                            IsIndeterminate="True" 
                            Foreground="#00ff88" 
                            Background="#27272a">
                    <ProgressBar.Effect>
                        <DropShadowEffect Color="#00ff88" BlurRadius="15" ShadowDepth="0"/>
                    </ProgressBar.Effect>
                </ProgressBar>
            </StackPanel>
        </Grid>
        
        <wv2:WebView2 Name="webView" />
    </Grid>
</Window>
